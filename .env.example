APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

API_RATE_LIMIT_PER_MINUTE=60

WAREHOUSE_GRPC_ENABLED=false
WAREHOUSE_GRPC_TARGET=127.0.0.1:50051
WAREHOUSE_GRPC_CONNECT_TIMEOUT_MS=500
WAREHOUSE_GRPC_READ_TIMEOUT_MS=1000
WAREHOUSE_GRPC_WRITE_TIMEOUT_MS=2500
WAREHOUSE_GRPC_RELEASE_TIMEOUT_MS=1500
WAREHOUSE_GRPC_REQUEST_BUDGET_MS=5000

PRODUCT_CACHE_ENABLED=true
PRODUCT_CACHE_TTL=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL only. Inside Docker, docker-compose.yml sets DB_HOST=mysql and DB_PORT=3306;
# from the host the same server is published on 127.0.0.1:3307.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=E-commerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Laravel queue: not used for order emails (those go through the RabbitMQ
# outbox, Requirement 4); other queued mail still runs in the request.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. The API container always uses MAIL_MAILER=log (docker-compose.yml);
# these values are what the email-worker container uses to send the order
# confirmation emails (Requirement 4). For Mailtrap Email Testing (sandbox):
#   MAIL_MAILER=smtp, MAIL_HOST=sandbox.smtp.mailtrap.io, MAIL_PORT=2525,
#   MAIL_USERNAME / MAIL_PASSWORD = the inbox's SMTP credentials.
# Never commit real credentials: keep them in .env only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Seconds before an SMTP connection/command gives up (worker side).
MAIL_TIMEOUT=15

# RabbitMQ (Requirement 4). docker-compose.yml refuses to start without a
# password; choose any local value. RABBITMQ_HOST/PORT are set by compose.
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Order confirmation emails: failed sends are retried this many times (the
# broker counts deliveries), then the message is dead-lettered to the DLQ.
ORDER_EMAIL_MAX_RETRIES=3
# Pause before handing a failed message back for its next attempt (ms x attempt).
ORDER_EMAIL_RETRY_BACKOFF_MS=2000
# Minimum gap between two sends (ms). Mail providers rate-limit: Mailtrap's
# free sandbox refuses bursts with "550 Too many emails per second", so ~15000
# there; 0 for a provider without a limit.
ORDER_EMAIL_MIN_INTERVAL_MS=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
