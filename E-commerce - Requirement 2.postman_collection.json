{
  "info": {
    "_postman_id": "bb6b6703-f129-4bf6-88f5-17096ffdc8c3",
    "name": "E-commerce - Requirement 2",
    "description": "Run the whole collection in order with the Collection Runner.\n\nNeeds `docker compose up -d` and a seeded database (admin@system.com / user@system.com, password `password123`). Each run creates its own category, product and orders, so IDs never have to be edited by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Logs in the seeded admin and user, and registers a fresh customer. Saves the three tokens.",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "_postman_id": "c7d09594-b1b3-4e1f-a550-d846afef7de3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Returns a Bearer token\", () => pm.expect(d.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"admin_token\", d.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as user",
          "request": {
