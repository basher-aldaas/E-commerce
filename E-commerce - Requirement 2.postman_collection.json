        {
          "name": "Register new customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Customer\",\n    \"email\": \"{{customer_email}}\",\n    \"password\": \"{{password}}\",\n    \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "_postman_id": "8d9daf19-bb1e-4966-9f1b-b752c6a6a5cc",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"run_id\", n);",
                  "pm.collectionVariables.set(\"customer_email\", \"customer\" + n + \"@test.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Returns a token and the user\", () => {",
                  "    pm.expect(d.access_token).to.be.a(\"string\");",
                  "    pm.expect(d.user.email).to.eql(pm.collectionVariables.get(\"customer_email\"));",
                  "});",
                  "pm.collectionVariables.set(\"customer_token\", d.access_token);"
                ]
              }
            }
          ]
        },
